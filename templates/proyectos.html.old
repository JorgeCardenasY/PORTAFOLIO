{% extends 'base.html' %} {% block title %}Mis Proyectos - Portafolio{% endblock%} {% block content %}
<div class="container contenido">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="card border-danger">
        <div class="card-header text-center py-4">
          <h4 class="card-title mb-0 text-danger">Mis Proyectos en GitHub</h4>
        </div>
        <div class="card-body text-white">
          <p>
            Aquí puedes explorar una selección de mis proyectos de desarrollo,
            alojados en mi repositorio de GitHub. Cada proyecto refleja mi
            experiencia y habilidades en diversas tecnologías.
          </p>

          <div class="text-center my-4">
            <a
              href="https://github.com/JorgeCardenasY?tab=repositories"
              target="_blank"
              class="btn btn-danger btn-lg"
            >
              <i class="bi bi-github me-2"></i>Ver todos mis repositorios en
              GitHub
            </a>
          </div>

          <hr class="border-danger my-4" />

          <h3 class="stronghold text-danger mb-4">Proyectos Destacados</h3>
          
          {% if projects %}
          <ul class="list-group list-group-flush">
            {% for project in projects %}
            <li class="list-group-item bg-dark text-white border-danger mt-1">
              <div class="row">
                <div class="col-md-4">
                  {% if project.image %}
                  <img src="{{ project.image.url }}" class="img-fluid rounded" alt="{{ project.title }}">
                  {% endif %}
                </div>
                <div class="col-md-8">
                  <h4 class="stronghold text-danger">{{ project.title }}</h4>
                  <p>{{ project.description }}</p>
                  {% if project.link %}
                  <a
                    href="{{ project.link }}"
                    target="_blank"
                    class="btn btn-sm btn-outline-danger"
                    >Ver Proyecto</a
                  >
                  {% endif %}
                </div>
              </div>
            </li>
            <br>
            {% endfor %}
          </ul>
          {% else %}
          <p>No hay proyectos para mostrar en este momento. ¡Vuelve pronto!</p>
          {% endif %}

          <p class="mt-4">
            Si tienes alguna pregunta sobre mis proyectos o te gustaría
            colaborar, no dudes en
            <a href="{% url 'contact' %}" class="text-danger">contactarme</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
